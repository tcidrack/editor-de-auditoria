# Copie para .env.local (já ignorado pelo git via *.local) e preencha com os dados do
# projeto Supabase: Settings > API.
#
# A anon key é pública por design — ela vai no bundle e quem protege os dados é o RLS.
# A service_role key NUNCA entra aqui: ela ignora o RLS e daria acesso a tudo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
